# Temporary internal API key; no product ownership model exists yet.
WYE_IMAGE_API_KEY=replace-me

# Dev/local only. Disabled by default; never expose WYE_IMAGE_API_KEY to mobile.
WYE_MOBILE_UPLOAD_FACADE_ENABLED=false
WYE_MOBILE_UPLOAD_FACADE_SESSION_TTL_SECONDS=300

WYE_STORAGE_PROVIDER=minio
WYE_STORAGE_ENDPOINT=http://localhost:9000
WYE_STORAGE_BUCKET=wye-private
WYE_STORAGE_REGION=us-east-1
WYE_STORAGE_ACCESS_KEY=replace-me
WYE_STORAGE_SECRET_KEY=replace-me
WYE_STORAGE_FORCE_PATH_STYLE=true
WYE_STORAGE_UPLOAD_TTL_SECONDS=900
WYE_STORAGE_READ_TTL_SECONDS=300
WYE_STORAGE_MAX_IMAGE_BYTES=15728640
WYE_STORAGE_CLEANUP_AFTER_SECONDS=1800

# Label extraction. The provider is selected explicitly; keys are never inferred.
WYE_EXTRACTION_PROVIDER=openai
WYE_OPENAI_API_KEY=replace-me
WYE_OPENAI_EXTRACTION_MODEL=gpt-4o-mini
WYE_EXTRACTION_TIMEOUT_SECONDS=90
# EFSA QPS acquisition (real network tests remain opt-in)
WYE_EFSA_QPS_RECORD_ID=21216051
WYE_EFSA_CONNECT_TIMEOUT_SECONDS=10
WYE_EFSA_READ_TIMEOUT_SECONDS=30
WYE_EFSA_MAX_ATTEMPTS=3
WYE_EFSA_BACKOFF_SECONDS=0.5
WYE_EFSA_MAX_ARTIFACT_BYTES=5242880
WYE_EFSA_USER_AGENT=WYE-scientific-ingestion/6.4.2
WYE_RUN_REAL_EFSA_TESTS=0

# OpenFoodTox 3.0 acquisition (official Zenodo XLSX; real tests are opt-in)
WYE_OPENFOODTOX_RECORD_ID=19388272
WYE_OPENFOODTOX_CONNECT_TIMEOUT_SECONDS=10
WYE_OPENFOODTOX_READ_TIMEOUT_SECONDS=120
WYE_OPENFOODTOX_MAX_ATTEMPTS=3
WYE_OPENFOODTOX_BACKOFF_SECONDS=0.5
WYE_OPENFOODTOX_MAX_ARTIFACT_BYTES=31457280
WYE_OPENFOODTOX_MAX_DECOMPRESSED_BYTES=167772160
WYE_OPENFOODTOX_USER_AGENT=WYE-scientific-ingestion/6.4.3
WYE_RUN_REAL_OPENFOODTOX_TESTS=0
